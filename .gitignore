# Python caches and local build artefacts
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
.agents/
.codex/
.idea/
.vscode/

